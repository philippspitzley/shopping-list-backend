{
  "name": "express-template",
  "version": "1.0.0",
  "description": "Starter for express server with drizzle orm",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "start": "NODE_ENV=production node --import tsx src/index.ts",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f mongodb",
    "db:shell": "docker exec -it shopping-list-mongo mongosh shopping-list",
    "db:seed": "NODE_ENV=development tsx src/db/seed.ts",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "template",
    "api",
    "nodejs",
    "express",
    "mongose",
    "shopping"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@epic-web/remember": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.1.2",
    "morgan": "^1.10.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@faker-js/faker": "^10.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
